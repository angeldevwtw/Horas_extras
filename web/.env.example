# Solo la URL y la clave publicable (anon). La service_role nunca va en el frontend.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxx

# Solo para web/api (funciones de Vercel), sin el prefijo VITE_, así nunca llega al navegador.
# Supabase → Project Settings → API Keys: la "secret" (sb_secret_...) o la service_role (legacy).
SUPABASE_SERVICE_ROLE_KEY=
